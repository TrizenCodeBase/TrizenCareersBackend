# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Configuration
MONGODB_URI=
# Optional: DNS for mongodb+srv SRV lookup (fixes querySrv ECONNREFUSED on some Windows/Node setups)
# MONGODB_DNS_SERVERS=8.8.8.8,8.8.4.4,1.1.1.1

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_password
EMAIL_FROM=noreply@trizen.com

# File Upload Configuration
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads

# MinIO / S3-compatible resume storage
# Set MINIO_ENDPOINT to an S3 API endpoint reachable from where this backend runs.
# In CapRover, use the MinIO app's internal service URL (no port if CapRover forwards HTTP port 80).
# For a backend running locally, use the MinIO S3 API's public HTTPS URL instead.
# MINIO_ENDPOINT=http://srv-captain--your-minio-app
# MINIO_PUBLIC_ENDPOINT=https://your-minio-api.example.com
# MINIO_ACCESS_KEY=
# MINIO_SECRET_KEY=
# MINIO_BUCKET=careers-resumes

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS Configuration
# Add all frontend URLs that need to access this backend
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173,http://localhost:5174,http://localhost:8080,https://careers.trizenventures.com,https://careersadminfrontend.llp.trizenventures.com
FRONTEND_URL=https://careers.trizenventures.com

# API Configuration
API_VERSION=v1
API_PREFIX=/api

# Email Service Configuration
EMAIL_SERVICE_URL=http://localhost:3002
EMAIL_SERVICE_API_KEY=trizen-support-email-2024-secure-key-xyz789