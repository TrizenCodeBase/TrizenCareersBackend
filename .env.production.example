# ============================================================
# PRODUCTION ENVIRONMENT VARIABLES (CapRover App Config)
# ============================================================
# Set ALL of these in CapRover → App → Environment Variables
# NEVER commit this file with real secrets to git.

# --- Server ---
PORT=5000
NODE_ENV=development
JWT_EXPIRES_IN=7d
API_VERSION=v1
API_PREFIX=/api

# --- MongoDB ---
MONGODB_URI=mongodb+srv://user:user@cluster0.ofoccow.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0

# --- JWT ---
JWT_SECRET=580d68997f0d87879c9bb092732abf51900ce005d94d6ef0f6465338f371bd1610257c16b27823483b81c7f08638f32e522fa9c4befaac2c03123f30db58d631

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:8080,http://localhost:3000,https://careers.trizenventures.com,https://careersadminfrontend.llp.trizenventures.com
FRONTEND_URL=https://careers.trizenventures.com

# --- MinIO (S3-compatible) ---
# MINIO_ENDPOINT: internal Docker endpoint used by backend to PUT/GET objects.
# This MUST be the CapRover internal service hostname (srv-captain--<appname>).
MINIO_ENDPOINT=http://srv-captain--trizencareer:9000

# MINIO_PUBLIC_ENDPOINT: public-facing MinIO URL used to generate presigned URLs
# for the browser to download resumes. Must be reachable from the browser.
MINIO_PUBLIC_ENDPOINT=https://trizencareer.llp.trizenventures.com:9000

# SSL is only for the public endpoint; the internal Docker connection uses plain HTTP
MINIO_USE_SSL=false

# Credentials
MINIO_ACCESS_KEY=7c49a66cc057aa7923d06add
MINIO_SECRET_KEY=2c292e40333eab287425026dbc2a3a8d5ab2da

# Region — must match what MinIO/S3 was initialized with
MINIO_REGION_NAME=eu-east-1

# Bucket name — REQUIRED. Code falls back to 'careers-resumes' if unset, but set it explicitly.
MINIO_BUCKET=careers-resumes

# Proxy URL used for resume downloads via backend (avoids direct browser→MinIO CORS issues)
MINIO_SERVER_URL=https://trizencareersbackend.llp.trizenventures.com
MINIO_RESUME_PROXY_URL=https://trizencareersbackend.llp.trizenventures.com/api/v1/applications/resume
